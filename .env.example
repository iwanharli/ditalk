# Copy to .env and fill in. Never commit the real .env.

PORT=8080
ENV=development
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://localhost:5432/db_ditalk?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0

# Local media feature extraction service (prosody, OCR)
AI_MEDIA_URL=http://127.0.0.1:8000

OPENAI_API_KEY=

# Model routing per doc bab 23A: tier 1 carries ~70% of volume,
# tier 3 only handles escalations.
MODEL_TIER1=gpt-5.6-luna
MODEL_TIER2=gpt-5.6-terra
MODEL_TIER3=gpt-5.6-sol
MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
MODEL_TRANSCRIBE_HQ=gpt-4o-transcribe
EMBEDDING_MODEL=text-embedding-3-small

# 32-byte key for field-level encryption of chat text, JIDs, and session creds.
# Generate: openssl rand -base64 32
# Production must source this from KMS/Vault, not from a file next to the DB.
ENCRYPTION_KEY=
JWT_SECRET=

# wa-connector
BACKEND_URL=http://localhost:8080
AUTH_DIR=./.auth
LOG_LEVEL=info
